{
  "name": "starbucks-web-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Starbucks fetch SDK and Bun CLI with manual browser login. Order submission disabled.",
  "bin": {
    "starbucks": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./login": {
      "types": "./dist/browser-login.d.ts",
      "import": "./dist/browser-login.js"
    }
  },
  "scripts": {
    "auth:fetch": "bun build scripts/fetch-login.mjs --target=node --packages=external --outfile=.starbucks/fetch-login.mjs > /dev/null && node --env-file=.env .starbucks/fetch-login.mjs",
    "test:fetch": "node --test tests/fetch-dom.test.mjs tests/fetch-policy.test.mjs",
    "history": "bun build scripts/history.mjs --target=node --packages=external --outfile=.starbucks/history.mjs && node .starbucks/history.mjs",
    "test:history": "bun test tests/history.test.mjs",
    "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && bun --bun tsc",
    "test": "bun run build && bun test ./tests",
    "starbucks": "bun dist/cli.js",
    "format": "oxfmt --write .",
    "lint": "oxlint --deny-warnings src tests scripts",
    "lint:fix": "oxlint --fix --deny-warnings src tests scripts",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "parse5": "8.0.0",
    "playwright": "^1.63.0",
    "tough-cookie": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "jsdom": "27.4.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "packageManager": "bun@1.3.14"
}
