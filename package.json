{
  "name": "starbucks-web-sdk",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && bun --bun tsc",
    "test": "bun run build && bun test ./tests",
    "starbucks": "bun dist/cli.js",
    "format": "bun --bun prettier --write src tests/*.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "commander": "^14.0.2",
    "parse5": "8.0.0",
    "tough-cookie": "^6.0.2",
    "playwright": "^1.63.0"
  },
  "version": "0.1.0",
  "description": "Starbucks fetch SDK and Bun CLI with manual browser login. Order submission disabled.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./login": {
      "types": "./dist/browser-login.d.ts",
      "import": "./dist/browser-login.js"
    }
  },
  "bin": {
    "starbucks": "./dist/cli.js"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "packageManager": "bun@1.3.14"
}
